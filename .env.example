# Copy this file to ".env" and fill in SM_TOKEN. Never commit ".env".

# REQUIRED. Secret used to access the stream (min 16 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SM_TOKEN=

# TCP port to listen on (on the Tailscale IP only).
SM_PORT=8787

# Monitor to mirror, as numbered by mss: 1 = first monitor, 2 = second, ...
# 0 = all monitors combined into one image.
SM_MONITOR=1

# Frames per second (1-60). Lower = less CPU and less data.
SM_FPS=15

# JPEG quality (10-95). Lower = smaller frames, blurrier picture.
SM_JPEG_QUALITY=60

# Resolution scale (0.1-1.0). 0.5 = half width and half height (~1/4 the pixels).
SM_SCALE=0.5

# Max simultaneous viewers (each one holds a server thread).
SM_MAX_CLIENTS=3

# Draw the mouse pointer on the stream (mss does not capture it itself). 1 or 0.
SM_CURSOR=1
